import { RoomManager } from '../../../packages/multiplayer/src/RoomManager.ts';
import { liarsDiceDefinition } from '../../../games/liars-dice/src/lib/server/definition.ts';
const rm = new RoomManager();
const { roomCode, playerId: a } = rm.createRoom('sa', 'A');
const j = rm.joinRoom(roomCode, 'sb', 'B'); const b = j.playerId!;
rm.setPlayerReady(a, true); rm.setPlayerReady(b, true);
const emitted: any[] = [];
const io: any = { to: (r: string) => ({ emit: (ev: string, d: any) => emitted.push([r, ev, d]) }) };
const players = rm.startGame(roomCode)!;
const cbs = liarsDiceDefinition.createLobbyCallbacks(rm, io);
cbs.onGameStart!(roomCode, players, io);
const eng: any = rm.getGameData(roomCode);
const st = eng.getState(); const p0 = st.players[0].id, p1 = st.players[1].id;
eng.placeBid(p0, 1, 2); eng.challenge(p1);
console.log('phase', eng.getState().phase, 'round', eng.getState().round);
rm.addSpectator(roomCode, 'spec1');
const specSocket: any = { data: { roomCode, playerId: undefined }, emit: (...x: any[]) => console.log('spec err', x) };
liarsDiceDefinition.handleGameAction(io, specSocket, rm, { type: 'nextRound' });
console.log('after spectator nextRound -> phase', eng.getState().phase, 'round', eng.getState().round, 'revealedDice', eng.getState().revealedDice);
